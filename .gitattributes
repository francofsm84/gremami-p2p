# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare text files to ensure LF on all platforms
*.jsx text eol=lf
*.js  text eol=lf
*.ts  text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf

# Binary files – never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
